# secrets
.env
*.local

# data (db, generated documents, uploads)
# Root-anchored on purpose. A bare "data/" also matches server/Data/ on a case-insensitive
# filesystem, which silently untracked Db.cs and Schema.sql — the app cannot compile or start
# without them.
/data/
/data-*/
*.db
*.db-shm
*.db-wal
*.db-journal

# .NET
[Bb]in/
[Oo]bj/
server/publish/
artifacts/
artifacts-*/
*.user

# node
node_modules/
web/node_modules/
web/dist/
.npm/

# build output: the SPA is generated into the backend's wwwroot by `npm run build`
server/wwwroot/

# editors / os
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# test output
TestResults/
coverage/