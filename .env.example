# resu-clean configuration. Copy to .env on first run (npm run dev / npm start do this for you).
# Secrets in .env are gitignored. Never commit an API key.

# ---- Server ----------------------------------------------------------------
# Port the backend listens on. In `npm start` this single port serves the API and the built UI.
RESUCLEAN_PORT=5177
# Interface to bind. Keep 127.0.0.1 for local-only use. Use 0.0.0.0 only with an API key set.
RESUCLEAN_HOST=127.0.0.1
# Optional. If set, every /api request must send header X-API-Key. Leave blank for no auth.
RESUCLEAN_API_KEY=
# Comma-separated extra origins allowed to call the API (the bundled UI is same-origin, so usually blank).
RESUCLEAN_CORS=
# Development only: expose /swagger at /swagger.
RESUCLEAN_SWAGGER=true

# ---- Limits ----------------------------------------------------------------
# Max upload size in megabytes (resume files and .zip/.eml uploads).
RESUCLEAN_MAX_UPLOAD_MB=10
# Max concurrent long-running operations (clean, search, kit generation).
RESUCLEAN_MAX_CONCURRENCY=2
# Seconds a fetched source page/feed is cached before refetching.
RESUCLEAN_CACHE_TTL_SECONDS=900
# Minimum milliseconds between two requests to the same source host.
RESUCLEAN_SOURCE_MIN_INTERVAL_MS=2000
# User-Agent sent to job sources. Be honest and identify the tool; add contact if you have one.
RESUCLEAN_USER_AGENT=resu-clean/1.0 (self-hosted personal resume toolkit; +http://localhost)

# ---- Models (optional) -----------------------------------------------------
# The app works fully with no model configured: deterministic clean, ATS scan, job search
# and template application kits all function. Set keys here OR add providers in the UI.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# ---- Paths -----------------------------------------------------------------
# Where the SQLite DB, generated .docx/.pdf/.eml/.zip and uploads live. Relative to the repo root.
RESUCLEAN_DATA_DIR=data